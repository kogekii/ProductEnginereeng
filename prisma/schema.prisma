generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}
enum ExceptionMode {
  INCLUDE
  EXCLUDE
}
enum DocumentType {
  GUARDIAN_IDENTITY
  EXTERNAL_IDENTITY
}
enum SubmissionStatus {
  RECEIVED
  PROCESSED
}
enum AuthorizationStatus {
  SIGNED
  ANNULLED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String? @unique
  phoneE164 String? @unique @map("phone_e164")
  firstName String @map("first_name")
  paternalSurname String @map("paternal_surname")
  maternalSurname String? @map("maternal_surname")
  isAdmin Boolean @default(false) @map("is_admin")
  isActive Boolean @default(true) @map("is_active")
  sessions Session[]
  guardianStudents GuardianStudent[]
  createdEvents Event[] @relation("EventCreator")
  submissions AuthorizationSubmission[]
  authorizations Authorization[] @relation("AuthorizationSigner")
  annulledAuthorizations Authorization[] @relation("AuthorizationAnnulment")
  auditLogs AuditLog[]
  documents Document[]
  @@map("user")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip String?
  userAgent String? @map("user_agent")
  user User @relation(fields: [userId], references: [id])
  submissions AuthorizationSubmission[]
  authorizations Authorization[]
  @@index([userId, expiresAt])
  @@map("session")
}

model Course {
  id String @id @default(uuid()) @db.Uuid
  name String
  level String
  year Int
  isActive Boolean @default(true) @map("is_active")
  students Student[]
  eventCourses EventCourse[]
  @@unique([name, year])
  @@map("course")
}

model Student {
  id String @id @default(uuid()) @db.Uuid
  documentType String @map("document_type")
  documentNumber String @unique @map("document_number")
  firstName String @map("first_name")
  paternalSurname String @map("paternal_surname")
  maternalSurname String? @map("maternal_surname")
  courseId String @map("course_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  course Course @relation(fields: [courseId], references: [id])
  guardianStudents GuardianStudent[]
  exceptions EventStudentException[]
  authorizations Authorization[]
  @@index([courseId, isActive])
  @@map("student")
}

model GuardianStudent {
  id String @id @default(uuid()) @db.Uuid
  guardianId String @map("guardian_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  relationship String
  isPrimary Boolean @default(false) @map("is_primary")
  guardian User @relation(fields: [guardianId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  @@unique([guardianId, studentId])
  @@index([studentId])
  @@map("guardian_student")
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  type String
  title String
  description String
  location String?
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  authorizationText String @map("authorization_text")
  deadlineAt DateTime @map("deadline_at") @db.Timestamptz(6)
  status EventStatus @default(DRAFT)
  createdById String @map("created_by_id") @db.Uuid
  createdBy User @relation("EventCreator", fields: [createdById], references: [id])
  courses EventCourse[]
  exceptions EventStudentException[]
  authorizations Authorization[]
  @@index([status, startsAt])
  @@index([deadlineAt])
  @@map("event")
}

model EventCourse {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])
  @@unique([eventId, courseId])
  @@map("event_course")
}

model EventStudentException {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  mode ExceptionMode
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  @@unique([eventId, studentId])
  @@index([eventId, studentId])
  @@map("event_student_exception")
}

model Document {
  id String @id @default(uuid()) @db.Uuid
  ownerId String? @map("owner_id") @db.Uuid
  type DocumentType
  privatePath String @map("private_path")
  mimeType String @map("mime_type")
  sizeBytes Int @map("size_bytes")
  sha256 String
  isEncrypted Boolean @default(false) @map("is_encrypted")
  isSimulated Boolean @default(false) @map("is_simulated")
  deleteAfter DateTime @map("delete_after") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner User? @relation(fields: [ownerId], references: [id])
  submissions AuthorizationSubmission[]
  authorizations Authorization[]
  @@map("document")
}

model AuthorizationSubmission {
  id String @id @default(uuid()) @db.Uuid
  guardianId String @map("guardian_id") @db.Uuid
  documentId String? @unique @map("document_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  ip String?
  userAgent String? @map("user_agent")
  sessionId String @map("session_id") @db.Uuid
  status SubmissionStatus @default(RECEIVED)
  resultSnapshot Json? @map("result_snapshot")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  guardian User @relation(fields: [guardianId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
  authorizations Authorization[]
  @@unique([guardianId, idempotencyKey])
  @@map("authorization_submission")
}

model Authorization {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  guardianId String @map("guardian_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  status AuthorizationStatus @default(SIGNED)
  signedAt DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)
  ip String?
  userAgent String? @map("user_agent")
  sessionId String @map("session_id") @db.Uuid
  authorizationTextSnapshot String @map("authorization_text_snapshot")
  authorizationTextHash String @map("authorization_text_hash")
  summarySnapshot Json @map("summary_snapshot")
  annulledAt DateTime? @map("annulled_at") @db.Timestamptz(6)
  annulledById String? @map("annulled_by_id") @db.Uuid
  annulmentReason String? @map("annulment_reason")
  event Event @relation(fields: [eventId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  guardian User @relation("AuthorizationSigner", fields: [guardianId], references: [id])
  submission AuthorizationSubmission @relation(fields: [submissionId], references: [id])
  document Document @relation(fields: [documentId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
  annulledBy User? @relation("AuthorizationAnnulment", fields: [annulledById], references: [id])
  @@index([submissionId])
  @@index([guardianId, status])
  @@index([eventId, status])
  @@map("authorization")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  entity String
  entityId String @map("entity_id") @db.Uuid
  metadata Json @default("{}")
  ip String?
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User? @relation(fields: [actorId], references: [id])
  @@index([entity, entityId])
  @@map("audit_log")
}
